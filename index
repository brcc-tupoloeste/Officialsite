<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f8324b" />
  <title>Barangay Tupol Oeste | Official Website</title>
  <style>
    :root{
      --red:#f8324b;
      --red-dark:#c81f35;
      --red-deep:#8f1426;
      --red-soft:#fff0f3;
      --red-soft-2:#fff7f8;
      --ink:#151515;
      --text:#27272a;
      --muted:#6b7280;
      --white:#ffffff;
      --bg:#f8f8f8;
      --border:#ece3e5;
      --shadow:0 10px 30px rgba(89, 24, 34, .08);
      --radius:18px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family:Arial, Helvetica, sans-serif;
      background:var(--bg);
      color:var(--text);
      line-height:1.5;
    }
    a{color:inherit;text-decoration:none}
    button{font:inherit}
    .container{
      width:min(1120px, calc(100% - 28px));
      margin:auto;
    }

    .topbar{
      background:var(--ink);
      color:#fff;
      font-size:13px;
      border-bottom:3px solid var(--red);
    }
    .topbar .container{
      min-height:34px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      flex-wrap:wrap;
    }

    header{
      position:sticky;
      top:0;
      z-index:50;
      background:rgba(255,255,255,.97);
      backdrop-filter:blur(8px);
      border-bottom:1px solid var(--border);
      box-shadow:0 3px 14px rgba(0,0,0,.04);
    }
    .nav{
      min-height:78px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:18px;
    }
    .brand{
      display:flex;
      align-items:center;
      gap:12px;
      min-width:0;
    }
    .brand img{
      width:58px;
      height:58px;
      object-fit:contain;
      flex:0 0 auto;
    }
    .brand-text strong{
      display:block;
      color:var(--red-dark);
      font-size:17px;
      line-height:1.08;
      letter-spacing:.2px;
    }
    .brand-text span{
      display:block;
      margin-top:4px;
      color:var(--muted);
      font-size:12px;
    }

    .nav-links{
      display:flex;
      align-items:center;
      gap:19px;
      font-size:14px;
      font-weight:800;
    }
    .nav-links a{position:relative}
    .nav-links a::after{
      content:"";
      position:absolute;
      left:0;
      bottom:-7px;
      width:0;
      height:2px;
      background:var(--red);
      transition:.2s ease;
    }
    .nav-links a:hover{color:var(--red-dark)}
    .nav-links a:hover::after{width:100%}

    .menu-btn{
      display:none;
      border:1px solid var(--border);
      background:#fff;
      border-radius:10px;
      padding:9px 11px;
      cursor:pointer;
      font-weight:800;
    }

    .hero{
      position:relative;
      overflow:hidden;
      background:
        radial-gradient(circle at 85% 16%, rgba(255,255,255,.16), transparent 23%),
        linear-gradient(135deg, var(--red) 0%, var(--red-dark) 58%, var(--red-deep) 100%);
      color:#fff;
      padding:70px 0 60px;
    }
    .hero::before{
      content:"";
      position:absolute;
      inset:auto -130px -210px auto;
      width:460px;
      height:460px;
      border:70px solid rgba(255,255,255,.06);
      border-radius:50%;
    }
    .hero-grid{
      position:relative;
      z-index:2;
      display:grid;
      grid-template-columns:1.18fr .82fr;
      gap:42px;
      align-items:center;
    }
    .eyebrow{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:7px 12px;
      border-radius:999px;
      background:rgba(255,255,255,.14);
      border:1px solid rgba(255,255,255,.25);
      font-size:12px;
      font-weight:800;
      margin-bottom:17px;
    }
    h1{
      margin:0 0 16px;
      font-size:clamp(38px,6vw,63px);
      line-height:1.02;
      letter-spacing:-1.6px;
    }
    .hero p{
      margin:0 0 25px;
      max-width:710px;
      color:#fff6f7;
      font-size:18px;
    }
    .hero-actions{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
    }
    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      padding:12px 17px;
      border-radius:12px;
      font-weight:900;
      border:1px solid transparent;
    }
    .btn-white{background:#fff;color:var(--red-dark)}
    .btn-outline{border-color:rgba(255,255,255,.65);color:#fff}

    .seal-card{
      background:#fff;
      border-radius:26px;
      padding:22px;
      box-shadow:0 22px 54px rgba(64,0,12,.23);
      color:var(--text);
      text-align:center;
    }
    .seal-card img{
      width:min(250px, 78%);
      aspect-ratio:1/1;
      object-fit:contain;
      filter:drop-shadow(0 9px 18px rgba(60,0,10,.10));
    }
    .seal-card h3{
      margin:10px 0 5px;
      color:var(--red-dark);
      font-size:19px;
    }
    .seal-card p{
      margin:0;
      color:var(--muted);
      font-size:13px;
    }

    .quick-strip{
      position:relative;
      z-index:3;
      margin-top:-28px;
    }
    .quick-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:13px;
    }
    .quick-item{
      background:#fff;
      border:1px solid var(--border);
      border-top:4px solid var(--red);
      box-shadow:var(--shadow);
      border-radius:15px;
      padding:15px;
      text-align:center;
      font-weight:900;
      color:var(--ink);
      transition:.2s ease;
    }
    .quick-item:hover{
      transform:translateY(-2px);
      color:var(--red-dark);
    }

    section{padding:64px 0}
    .section-head{
      display:flex;
      justify-content:space-between;
      align-items:flex-end;
      gap:16px;
      margin-bottom:24px;
    }
    .section-head h2{
      margin:0;
      font-size:32px;
      color:var(--ink);
      letter-spacing:-.5px;
    }
    .section-head h2 span{color:var(--red)}
    .section-head p{
      margin:7px 0 0;
      max-width:650px;
      color:var(--muted);
    }

    .grid{
      display:grid;
      gap:18px;
    }
    .grid-3{grid-template-columns:repeat(3,1fr)}
    .grid-4{grid-template-columns:repeat(4,1fr)}

    .card{
      background:#fff;
      border:1px solid var(--border);
      border-radius:var(--radius);
      padding:20px;
      box-shadow:var(--shadow);
    }
    .card h3{
      margin:0 0 8px;
      color:var(--ink);
      font-size:18px;
    }
    .card p{
      margin:0;
      color:var(--muted);
      font-size:14px;
    }
    .icon{
      width:46px;
      height:46px;
      display:grid;
      place-items:center;
      border-radius:13px;
      background:var(--red-soft);
      color:var(--red-dark);
      font-size:23px;
      margin-bottom:14px;
      border:1px solid #ffdce2;
    }

    .ann-card{
      display:flex;
      flex-direction:column;
      min-height:192px;
      border-top:4px solid var(--red);
    }
    .date{
      color:var(--red-dark);
      font-size:12px;
      font-weight:900;
      letter-spacing:.4px;
      text-transform:uppercase;
      margin-bottom:7px;
    }
    .more{
      margin-top:auto;
      padding-top:15px;
      color:var(--red-dark);
      font-weight:900;
      font-size:14px;
    }

    .services{
      background:linear-gradient(180deg,var(--red-soft-2),#fff);
      border-top:1px solid var(--border);
      border-bottom:1px solid var(--border);
    }

    .official{text-align:center}
    .avatar{
      width:78px;
      height:78px;
      margin:0 auto 12px;
      border-radius:50%;
      display:grid;
      place-items:center;
      background:var(--red-soft);
      border:3px solid #ffd8df;
      color:var(--red-dark);
      font-weight:900;
      font-size:25px;
    }
    .official small{color:var(--muted)}

    .program-card{
      position:relative;
      overflow:hidden;
    }
    .program-card::after{
      content:"";
      position:absolute;
      width:70px;
      height:70px;
      border-radius:50%;
      background:var(--red-soft);
      right:-27px;
      bottom:-27px;
    }

    .contact-box{
      background:linear-gradient(135deg,#202020 0%, #111 100%);
      color:#fff;
      border-radius:24px;
      overflow:hidden;
      display:grid;
      grid-template-columns:.9fr 1.1fr;
      box-shadow:0 18px 40px rgba(0,0,0,.14);
    }
    .contact-intro{
      padding:28px;
      background:linear-gradient(150deg,var(--red),var(--red-dark));
    }
    .contact-intro h2{margin:0 0 10px}
    .contact-intro p{color:#fff0f3}
    .contact-list{
      padding:28px;
      display:grid;
      gap:12px;
      align-content:center;
    }
    .contact-item{
      padding:12px 14px;
      border:1px solid rgba(255,255,255,.14);
      border-radius:12px;
      background:rgba(255,255,255,.05);
    }
    .contact-item strong{display:block}
    .contact-item span{font-size:13px;color:#d7d7d7}

    footer{
      background:#0e0e0e;
      color:#d1d1d1;
      border-top:5px solid var(--red);
      padding:27px 0;
      font-size:13px;
    }
    footer .container{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:20px;
      flex-wrap:wrap;
    }
    .footer-brand{
      display:flex;
      align-items:center;
      gap:10px;
    }
    .footer-brand img{
      width:48px;
      height:48px;
      object-fit:contain;
      background:#fff;
      border-radius:50%;
      padding:2px;
    }

    @media(max-width:900px){
      .hero-grid{grid-template-columns:1fr}
      .quick-grid{grid-template-columns:repeat(2,1fr)}
      .grid-4{grid-template-columns:repeat(2,1fr)}
      .grid-3{grid-template-columns:1fr 1fr}
      .contact-box{grid-template-columns:1fr}
      .nav-links{
        position:absolute;
        top:78px;
        left:14px;
        right:14px;
        display:none;
        flex-direction:column;
        align-items:stretch;
        gap:0;
        background:#fff;
        border:1px solid var(--border);
        border-radius:14px;
        box-shadow:var(--shadow);
        overflow:hidden;
      }
      .nav-links.show{display:flex}
      .nav-links a{padding:13px 16px;border-bottom:1px solid var(--border)}
      .nav-links a::after{display:none}
      .menu-btn{display:block}
    }

    @media(max-width:620px){
      .container{width:min(100% - 20px,1120px)}
      .topbar .container{justify-content:center;text-align:center;padding:5px 0}
      .brand img{width:49px;height:49px}
      .brand-text strong{font-size:14px}
      .brand-text span{font-size:11px}
      .hero{padding:45px 0 52px}
      h1{font-size:39px}
      .hero p{font-size:16px}
      .seal-card img{width:190px}
      .quick-strip{margin-top:-22px}
      .quick-grid{grid-template-columns:1fr 1fr}
      .quick-item{font-size:13px;padding:13px 8px}
      section{padding:46px 0}
      .section-head{align-items:flex-start;flex-direction:column}
      .section-head h2{font-size:27px}
      .grid-4,.grid-3{grid-template-columns:1fr}
      .card{padding:18px}
      .contact-intro,.contact-list{padding:20px}
      footer .container{align-items:flex-start;flex-direction:column}
    }
  </style>
</head>
<body>
  <div class="topbar">
    <div class="container">
      <span>Republic of the Philippines · Municipality of Cabatuan · Province of Iloilo</span>
      <span>Official Barangay Information Portal</span>
    </div>
  </div>

  <header>
    <div class="container nav">
      <a class="brand" href="#home">
        <img src="barangay-logo.png" alt="Barangay Tupol Oeste Logo">
        <div class="brand-text">
          <strong>BARANGAY TUPOL OESTE</strong>
          <span>Municipality of Cabatuan, Iloilo</span>
        </div>
      </a>

      <button class="menu-btn" id="menuBtn" aria-label="Open navigation">☰ Menu</button>

      <nav class="nav-links" id="navLinks">
        <a href="#home">Home</a>
        <a href="#announcements">Announcements</a>
        <a href="#services">Services</a>
        <a href="#officials">Officials</a>
        <a href="#programs">Programs</a>
        <a href="#contacts">Contacts</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" id="home">
      <div class="container hero-grid">
        <div>
          <span class="eyebrow">● Official Barangay Website</span>
          <h1>Barangay Tupol Oeste</h1>
          <p>
            Your online community information portal for barangay announcements,
            public services, programs, projects, activities, and important contact information.
          </p>
          <div class="hero-actions">
            <a class="btn btn-white" href="#announcements">📢 View Announcements</a>
            <a class="btn btn-outline" href="#services">🏛 Barangay Services</a>
          </div>
        </div>

        <div class="seal-card">
          <img src="barangay-logo.png" alt="Official Seal of Barangay Tupol Oeste">
          <h3>Municipality of Cabatuan</h3>
          <p>Province of Iloilo · Republic of the Philippines</p>
        </div>
      </div>
    </section>

    <div class="quick-strip">
      <div class="container quick-grid">
        <a class="quick-item" href="#announcements">📣 Announcements</a>
        <a class="quick-item" href="#services">📄 Certificates</a>
        <a class="quick-item" href="#programs">🤝 Programs</a>
        <a class="quick-item" href="#contacts">☎ Emergency Contacts</a>
      </div>
    </div>

    <section id="announcements">
      <div class="container">
        <div class="section-head">
          <div>
            <h2>Latest <span>Announcements</span></h2>
            <p>Official barangay notices, schedules, public advisories, and community activities.</p>
          </div>
        </div>

        <div class="grid grid-3">
          <article class="card ann-card">
            <div class="date">October 11, 2026 · 8:30 AM</div>
            <h3>Limpyo Iloilo</h3>
            <p>
              Barangay officials, tanods, volunteers, SK officials, farmers,
              women’s groups, and other barangay organizations are encouraged to participate.
            </p>
            <div class="more">View activity →</div>
          </article>

          <article class="card ann-card">
            <div class="date">Barangay Advisory</div>
            <h3>Barangay Office Services</h3>
            <p>
              Information regarding barangay clearance, residency, indigency,
              business clearance, and other certifications may be posted here.
            </p>
            <div class="more">View services →</div>
          </article>

          <article class="card ann-card">
            <div class="date">Health & Safety</div>
            <h3>Anti-Rabies Program</h3>
            <p>
              Support dog registration, annual anti-rabies vaccination,
              and responsible pet ownership in the community.
            </p>
            <div class="more">View program →</div>
          </article>
        </div>
      </div>
    </section>

    <section class="services" id="services">
      <div class="container">
        <div class="section-head">
          <div>
            <h2>Barangay <span>Services</span></h2>
            <p>Quick access to commonly requested barangay documents and public services.</p>
          </div>
        </div>

        <div class="grid grid-4">
          <div class="card">
            <div class="icon">📄</div>
            <h3>Barangay Clearance</h3>
            <p>For employment, transactions, applications, and other lawful purposes.</p>
          </div>
          <div class="card">
            <div class="icon">🏠</div>
            <h3>Certificate of Residency</h3>
            <p>Certification that an individual is currently residing in the barangay.</p>
          </div>
          <div class="card">
            <div class="icon">🤝</div>
            <h3>Certificate of Indigency</h3>
            <p>For qualified residents requiring proof of indigency for assistance.</p>
          </div>
          <div class="card">
            <div class="icon">🏪</div>
            <h3>Business Clearance</h3>
            <p>Barangay clearance for qualified businesses operating within the community.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="officials">
      <div class="container">
        <div class="section-head">
          <div>
            <h2>Barangay <span>Officials</span></h2>
            <p>Current barangay officials and their respective committee assignments.</p>
          </div>
        </div>

        <div class="grid grid-4">
          <div class="card official">
            <div class="avatar">PB</div>
            <h3>Punong Barangay</h3>
            <small>Name of Punong Barangay</small>
          </div>
          <div class="card official">
            <div class="avatar">KG</div>
            <h3>Barangay Kagawad</h3>
            <small>Committee Assignment</small>
          </div>
          <div class="card official">
            <div class="avatar">KG</div>
            <h3>Barangay Kagawad</h3>
            <small>Committee Assignment</small>
          </div>
          <div class="card official">
            <div class="avatar">SK</div>
            <h3>SK Chairperson</h3>
            <small>Sangguniang Kabataan</small>
          </div>
        </div>
      </div>
    </section>

    <section id="programs">
      <div class="container">
        <div class="section-head">
          <div>
            <h2>Programs & <span>Projects</span></h2>
            <p>Community programs focused on public health, agriculture, environment, and social welfare.</p>
          </div>
        </div>

        <div class="grid grid-4">
          <div class="card program-card">
            <div class="icon">🐕</div>
            <h3>Anti-Rabies</h3>
            <p>Dog registration, vaccination, public awareness, and responsible pet ownership.</p>
          </div>
          <div class="card program-card">
            <div class="icon">🌾</div>
            <h3>Agriculture</h3>
            <p>Farmer support, coordination, communal gardening, and agricultural activities.</p>
          </div>
          <div class="card program-card">
            <div class="icon">♻️</div>
            <h3>Environment</h3>
            <p>Clean-up drives, waste management, environmental protection, and beautification.</p>
          </div>
          <div class="card program-card">
            <div class="icon">❤️</div>
            <h3>Health & Social Services</h3>
            <p>Health activities, senior citizens, blood donation, and community assistance.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="contacts">
      <div class="container">
        <div class="contact-box">
          <div class="contact-intro">
            <h2>Emergency & Barangay Contacts</h2>
            <p>
              Important verified barangay and emergency contact numbers can be published here for quick access.
            </p>
            <a class="btn btn-white" href="#">☎ Barangay Office</a>
          </div>

          <div class="contact-list">
            <div class="contact-item">
              <strong>Barangay Office</strong>
              <span>Contact number to be added</span>
            </div>
            <div class="contact-item">
              <strong>Barangay Health Station</strong>
              <span>Contact number to be added</span>
            </div>
            <div class="contact-item">
              <strong>Police / Emergency</strong>
              <span>Verified local number to be added</span>
            </div>
            <div class="contact-item">
              <strong>Fire / MDRRMO</strong>
              <span>Verified local number to be added</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <div class="footer-brand">
        <img src="barangay-logo.png" alt="Barangay Tupol Oeste Logo">
        <div>
          <strong>Barangay Tupol Oeste</strong><br>
          Municipality of Cabatuan, Province of Iloilo
        </div>
      </div>
      <div>© <span id="year"></span> Barangay Tupol Oeste. All rights reserved.</div>
    </div>
  </footer>

  <script>
    const menuBtn = document.getElementById('menuBtn');
    const navLinks = document.getElementById('navLinks');

    menuBtn.addEventListener('click', () => {
      navLinks.classList.toggle('show');
    });

    document.querySelectorAll('#navLinks a').forEach(link => {
      link.addEventListener('click', () => navLinks.classList.remove('show'));
    });

    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
</body>
</html>
